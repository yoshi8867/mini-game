# 이 파일을 .env 로 복사해서 실제 값을 넣는다. .env 는 커밋되지 않는다.
# Neon 은 반드시 -pooler 붙은 풀링 주소를 쓴다. 무료 인스턴스는 연결 수가 적다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
PORT=3000

# 관리자 비번. 비워 두면 admin.js 에 박은 해시를 쓴다.
ADMIN_PW=

# 블라인드의 진짜 판. 비우면 props.js 에 적힌 연습판으로 돌린다.
# server/props.local.js 에 적은 뒤 node tools/pack-props.js --env 로 찍어 붙인다.
OMR_PROPS=
